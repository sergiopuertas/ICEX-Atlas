# =============================================================================
# ICEX Atlas · variables de entorno (plantilla). NUNCA subir valores reales.
# Copias reales: .env (raíz, CI/Fastlane), supabase/functions/.env (Edge Functions local),
# app/env/<entorno>.json (dart-define de la app). Todas en .gitignore.
# =============================================================================

# ---------------------------------------------------------------- App Flutter --
# Se pasan con: flutter run --dart-define-from-file=app/env/local.json
SUPABASE_URL=http://127.0.0.1:54321            # prod: https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=                             # clave pública (anon/publishable). Nunca la service_role
OIDC_PROVIDER=custom:icex-alumni
AUTH_REDIRECT=es.icexalumni.atlas://login-callback
APP_ENV=local                                  # local | staging | production
SENTRY_DSN=                                    # vacío = Sentry desactivado
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png   # en producción, proveedor con SLA (ver runbook)
MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
ASSOCIATION_WEB_URL=https://icex-alumni.com
MEMBERSHIP_URL=https://icex-alumni.com/hazte-alumni/
SHOW_DEMO_BANNER=true                          # false en producción
AUTH_MODE=oidc                                 # oidc (socios) | password (beta abierta: email y contraseña)
FEEDBACK_URL=                                  # beta: formulario de comentarios (Ajustes → Enviar comentarios)
PRIVACY_URL=                                   # política de privacidad (obligatoria para la beta y las tiendas)

# ------------------------------------------- Proveedor OIDC (Supabase Auth) --
# Local: docker/oidc-provider. Producción: WordPress (wordpress/README.md)
OIDC_ISSUER=https://idp.icex-atlas.test:9010   # prod: https://<web-icex-alumni> (HTTPS, dominio público)
OIDC_CLIENT_ID=supabase-local
OIDC_CLIENT_SECRET=supabase-local-secret

# ------------------------------------- Secretos de Edge Functions (supabase) --
# Producción: supabase secrets set --env-file supabase/functions/.env.production
LLM_PROVIDER=mock                              # mock | openai-compatible | anthropic
LLM_BASE_URL=                                  # p. ej. endpoint UE del proveedor elegido
LLM_API_KEY=
LLM_MODEL=
EMBEDDINGS_PROVIDER=mock                       # mock | supabase-gte-small (384 dims, sin salir de Supabase)
PUSH_PROVIDER=mock                             # mock | fcm
FCM_SERVICE_ACCOUNT_JSON=                      # JSON de la cuenta de servicio de Firebase (una línea)
WP_BASE_URL=https://idp.icex-atlas.test:9010   # web WordPress (endpoint de sincronía)
WP_SYNC_TOKEN=dev-sync-token                   # = ICEX_ATLAS_SYNC_TOKEN de wp-config.php (≥ 32 caracteres en prod)
MEMBERSHIP_MAX_REVOKE_RATIO=0.05               # freno: aborta si se revocaría a más del 5 %
ADMIN_ALLOWED_ORIGINS=http://localhost:3000    # CORS del panel admin (prod: https://admin.<dominio>)
# Email transaccional (proveedor con tratamiento en la UE). Reservado: el MVP aún no envía emails.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# ------------------------------------------- Beta en la nube (Deploy backend) --
# Los aplica scripts/deploy/configure_supabase.py. Guía completa: docs/beta.md
ACCESS_MODE=open_beta                          # open_beta (registro con email) | alumni (solo socios)
EXTRA_REDIRECT_URLS=                           # URLs extra permitidas tras login (coma), p. ej. panel admin
SMTP_HOST=                                     # correos de Auth (confirmación, contraseña): SMTP de Mailrelay (panel → SMTP)
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_EMAIL=                             # remitente de un dominio verificado, p. ej. beta@tudominio.es
SMTP_SENDER_NAME=ICEX Atlas
EMAIL_RATE_LIMIT_PER_HOUR=100

# --------------------------------------------------- CI/CD (GitHub Actions) --
SUPABASE_ACCESS_TOKEN=                         # token personal de la CLI (despliegues)
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SENTRY_AUTH_TOKEN=                             # subida de símbolos
# Distribución de la beta (Release beta)
FIREBASE_ANDROID_APP_ID=                       # 1:1234567890:android:abc… (Firebase → Configuración del proyecto)
FIREBASE_SERVICE_ACCOUNT_JSON=                 # cuenta de servicio con rol «Firebase App Distribution Admin»
FIREBASE_TESTER_GROUPS=beta                    # alias del grupo de probadores en App Distribution
TESTFLIGHT_GROUPS=                             # p. ej. Beta (grupo externo de TestFlight); vacío = solo subir

# ---------------------------------------------------------------- Fastlane --
# iOS (App Store Connect API key + match)
APP_STORE_CONNECT_API_KEY_ID=
APP_STORE_CONNECT_API_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_CONTENT=             # contenido del .p8 (base64)
APPLE_TEAM_ID=
MATCH_GIT_URL=                                 # repo privado de certificados
MATCH_PASSWORD=
# Android (Play Console)
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
PLAY_JSON_KEY_BASE64=                          # cuenta de servicio de Google Play
